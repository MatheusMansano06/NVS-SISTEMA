# Copie para .env (nunca commitar .env)
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
DATABASE_URL=postgres://nvs:nvs_dev_password@localhost:5432/nvs_dev
# Gere um valor forte em produção: openssl rand -hex 48
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173

# Banco exclusivo dos testes automatizados (nunca o mesmo do desenvolvimento)
TEST_DATABASE_URL=postgres://nvs:nvs_dev_password@localhost:5432/nvs_test

# Mercado Livre (DevCenter → sua aplicação)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa ser IDÊNTICA à cadastrada no DevCenter (HTTPS público)
ML_REDIRECT_URI=https://SEU-DOMINIO/api/v1/integrations/mercado-livre/callback
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
ML_USE_PKCE=true
